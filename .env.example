EXPO_PUBLIC_SUPABASE_URL=https://yihcktculicmuuzzxzik.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Google OAuth is configured server-side in Supabase Auth and remains the default login.
# Enable Microsoft only after configuring the Azure provider in Supabase Auth.
EXPO_PUBLIC_ENABLE_AZURE_AUTH=false

# Enable only when at least one SAML/SSO tenant is registered in Supabase Auth.
EXPO_PUBLIC_ENABLE_ENTERPRISE_SSO=false
